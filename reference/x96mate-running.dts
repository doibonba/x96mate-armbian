/dts-v1/;

/ {
	#address-cells = <0x02>;
	model = "X96 Mate";
	serial-number = "32c0500063aacc40";
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	compatible = "hechuang,x96-mate\0allwinner,sun50i-h616";

	vcc5v {
		regulator-max-microvolt = <0x4c4b40>;
		regulator-always-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-name = "vcc-5v";
		compatible = "regulator-fixed";
		phandle = <0x33>;
	};

	connector {
		type = "a";
		compatible = "hdmi-connector";

		port {

			endpoint {
				remote-endpoint = <0x36>;
				phandle = <0x27>;
			};
		};
	};

	wifi-pwrseq {
		reset-gpios = <0x41 0x06 0x06 0x01>;
		compatible = "mmc-pwrseq-simple";
		phandle = <0xa9>;
	};

	thermal-zones {

		cpu-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x1f4>;
			thermal-sensors = <0x34 0x02>;
			sustainable-power = <0x3e8>;

			trips {

				cpu-trip-2 {
					temperature = <0x1adb0>;
					hysteresis = <0x00>;
					type = "critical";
					phandle = <0xa5>;
				};

				cpu-trip-0 {
					temperature = <0xea60>;
					hysteresis = <0x00>;
					type = "passive";
					phandle = <0xa3>;
				};

				cpu-trip-1 {
					temperature = <0x11170>;
					hysteresis = <0x00>;
					type = "passive";
					phandle = <0xa4>;
				};
			};
		};

		ddr-thermal {
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
			thermal-sensors = <0x34 0x03>;

			trips {

				ddr-trip-0 {
					temperature = <0x1adb0>;
					hysteresis = <0x00>;
					type = "critical";
					phandle = <0xa8>;
				};
			};
		};

		ve-thermal {
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
			thermal-sensors = <0x34 0x01>;

			trips {

				ve-trip-0 {
					temperature = <0x1adb0>;
					hysteresis = <0x00>;
					type = "critical";
					phandle = <0xa7>;
				};
			};
		};

		gpu-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x1f4>;
			thermal-sensors = <0x34 0x00>;
			sustainable-power = <0x44c>;

			trips {

				gpu-trip-0 {
					temperature = <0x1adb0>;
					hysteresis = <0x00>;
					type = "critical";
					phandle = <0xa6>;
				};
			};
		};
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0x40000000>;

		phy@5100400 {
			clock-names = "usb0_phy\0usb1_phy\0usb2_phy\0usb3_phy\0pmu2_clk";
			reg-names = "phy_ctrl\0pmu0\0pmu1\0pmu2\0pmu3";
			resets = <0x02 0x26 0x02 0x27 0x02 0x28 0x02 0x29>;
			clocks = <0x02 0x61 0x02 0x63 0x02 0x65 0x02 0x67 0x02 0x6e>;
			#phy-cells = <0x01>;
			compatible = "allwinner,sun50i-h616-usb-phy";
			status = "okay";
			reg = <0x5100400 0x24 0x5101800 0x14 0x5200800 0x14 0x5310800 0x14 0x5311800 0x14>;
			phandle = <0x24>;
			reset-names = "usb0_reset\0usb1_reset\0usb2_reset\0usb3_reset";
		};

		gpu@1800000 {
			power-domains = <0x0e 0x02>;
			clock-names = "core\0bus";
			resets = <0x02 0x03>;
			interrupts = <0x00 0x5f 0x04 0x00 0x60 0x04 0x00 0x61 0x04>;
			clocks = <0x02 0x23 0x02 0x24>;
			compatible = "allwinner,sun50i-h616-mali\0arm,mali-bifrost";
			status = "disabled";
			interrupt-names = "job\0mmu\0gpu";
			reg = <0x1800000 0x40000>;
			phandle = <0x39>;
		};

		syscon@3000000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "allwinner,sun50i-h616-system-control";
			ranges;
			reg = <0x3000000 0x30 0x3000038 0xfc8>;
			phandle = <0x1a>;

			sram@1a00000 {
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				compatible = "mmio-sram";
				ranges = <0x00 0x1a00000 0x200000>;
				reg = <0x1a00000 0x200000>;
				phandle = <0x3e>;

				sram-section@0 {
					compatible = "allwinner,sun50i-h616-sram-c1";
					reg = <0x00 0x200000>;
					phandle = <0x10>;
				};
			};

			sram@100000 {
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				compatible = "mmio-sram";
				ranges = <0x00 0x100000 0x18000>;
				reg = <0x100000 0x18000>;
				phandle = <0x3b>;

				scpi-sram@17c00 {
					compatible = "arm,scp-shmem";
					reg = <0x17c00 0x200>;
					phandle = <0x3c>;
				};
			};

			sram@28000 {
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				compatible = "mmio-sram";
				ranges = <0x00 0x28000 0x30000>;
				reg = <0x28000 0x30000>;
				phandle = <0x3d>;

				sram-section@0 {
					compatible = "allwinner,sun50i-h616-sram-c\0allwinner,sun50i-a64-sram-c";
					reg = <0x00 0x1e000>;
					phandle = <0x0b>;
				};
			};
		};

		mmc@4022000 {
			mmc-ddr-3_3v;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			pinctrl-0 = <0x15>;
			clock-names = "ahb\0mmc";
			cap-sd-highspeed;
			vqmmc-supply = <0x16>;
			mmc-hs200-1_8v;
			bus-width = <0x08>;
			non-removable;
			resets = <0x02 0x10>;
			cap-sdio-irq;
			interrupts = <0x00 0x25 0x04>;
			clocks = <0x02 0x41 0x02 0x3e>;
			#size-cells = <0x00>;
			vmmc-supply = <0x13>;
			cap-mmc-hw-reset;
			mmc-ddr-1_8v;
			compatible = "allwinner,sun50i-h616-emmc\0allwinner,sun50i-a100-emmc";
			status = "okay";
			reg = <0x4022000 0x1000>;
			phandle = <0x68>;
			max-frequency = <0x8f0d180>;
			cap-mmc-highspeed;
			reset-names = "ahb";
		};

		ethernet@5030000 {
			rx-delay = <0x1f>;
			gmac-power1;
			pinctrl-names = "default";
			phy-supply = <0x1d>;
			phy-mode = "rmii";
			phy-rst;
			tx-delay = <0x07>;
			pinctrl-0 = <0x1b>;
			clock-names = "bus-emac1\0emac-25m";
			reg-names = "gmac1_reg\0ephy_reg";
			local-mac-address = [02 00 63 aa cc 40];
			resets = <0x02 0x1f>;
			interrupts = <0x00 0x0f 0x04>;
			clocks = <0x02 0x53 0x02 0x51>;
			gmac-power2;
			gmac-power0;
			compatible = "allwinner,sunxi-gmac";
			status = "okay";
			interrupt-names = "gmacirq";
			reg = <0x5030000 0x10000 0x3000034 0x04>;
			phandle = <0x78>;
			allwinner,tx-delay-ps = <0x2bc>;
			phy-handle = <0x1c>;
			reset-names = "stmmaceth";
			allwinner,rx-delay-ps = <0xc1c>;

			mdio {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "ethernet-phy-ieee802.3-c22";
				phandle = <0x79>;

				ethernet-phy@1 {
					compatible = "ethernet-phy-ieee802.3-c22";
					reg = <0x01>;
					phandle = <0x1c>;
				};
			};
		};

		lradc@5070800 {
			resets = <0x02 0x3b>;
			interrupts = <0x00 0x14 0x04>;
			clocks = <0x02 0x71>;
			compatible = "allwinner,sun50i-h616-lradc\0allwinner,sun50i-r329-lradc";
			status = "disabled";
			reg = <0x5070800 0x400>;
			phandle = <0x7c>;
		};

		hdmi@6000000 {
			reg-io-width = <0x01>;
			phy-names = "phy";
			clock-names = "iahb\0isfr\0tmds\0cec\0hdcp\0hdcp-bus";
			hvcc-supply = <0x16>;
			resets = <0x02 0x33 0x02 0x3a>;
			interrupts = <0x00 0x3f 0x04>;
			clocks = <0x02 0x75 0x02 0x73 0x02 0x72 0x02 0x74 0x02 0x7e 0x02 0x7f>;
			#sound-dai-cells = <0x00>;
			compatible = "allwinner,sun50i-h616-dw-hdmi\0allwinner,sun50i-h6-dw-hdmi";
			status = "okay";
			phys = <0x25>;
			reg = <0x6000000 0x10000>;
			phandle = <0x23>;
			reset-names = "ctrl\0hdcp";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;
					phandle = <0x8d>;

					endpoint {
						remote-endpoint = <0x26>;
						phandle = <0x2b>;
					};
				};

				port@1 {
					reg = <0x01>;
					phandle = <0x8e>;

					endpoint {
						remote-endpoint = <0x27>;
						phandle = <0x36>;
					};
				};
			};
		};

		clock@7010000 {
			#reset-cells = <0x01>;
			clock-names = "hosc\0losc\0iosc\0pll-periph";
			clocks = <0x11 0x0f 0x00 0x0f 0x02 0x02 0x04>;
			#clock-cells = <0x01>;
			compatible = "allwinner,sun50i-h616-r-ccu";
			reg = <0x7010000 0x210>;
			phandle = <0x2f>;
		};

		pinctrl@300b000 {
			clock-names = "apb\0hosc\0losc";
			gpio-controller;
			interrupts = <0x00 0x33 0x04 0x00 0x34 0x04 0x00 0x35 0x04 0x00 0x2b 0x04 0x00 0x36 0x04 0x00 0x37 0x04 0x00 0x38 0x04 0x00 0x39 0x04>;
			clocks = <0x02 0x1a 0x11 0x0f 0x00>;
			compatible = "allwinner,sun50i-h616-pinctrl";
			#interrupt-cells = <0x03>;
			reg = <0x300b000 0x400>;
			phandle = <0x41>;
			#gpio-cells = <0x03>;
			interrupt-controller;

			i2c4-ph-pins {
				function = "i2c4";
				pins = "PH6\0PH7";
				phandle = <0x4a>;
			};

			pwm2-ph-pin {
				function = "pwm2";
				pins = "PH2";
				phandle = <0x50>;
			};

			pwm3-ph-pin {
				function = "pwm3";
				pins = "PH0";
				phandle = <0x51>;
			};

			uart2-pg-pins {
				function = "uart2";
				pins = "PG15\0PG16";
				phandle = <0x5c>;
			};

			pwm4-ph-pin {
				function = "pwm4";
				pins = "PH1";
				phandle = <0x52>;
			};

			spi1-cs0-pin {
				function = "spi1";
				pins = "PH5";
				phandle = <0x57>;
			};

			i2c1-pi-pins {
				function = "i2c1";
				pins = "PI7\0PI8";
				phandle = <0x43>;
			};

			i2c4-pg-pins {
				function = "i2c4";
				pins = "PG15\0PG16";
				phandle = <0x49>;
			};

			uart5-pins {
				function = "uart5";
				pins = "PH2\0PH3";
				phandle = <0x63>;
			};

			rmii-pins {
				function = "emac1";
				pins = "PA0\0PA1\0PA2\0PA3\0PA4\0PA5\0PA6\0PA7\0PA8\0PA9";
				drive-strength = <0x28>;
				phandle = <0x1b>;
			};

			pwm1-pi-pin {
				function = "pwm1";
				pins = "PI11";
				phandle = <0x4f>;
			};

			pwm5-pin {
				function = "pwm5";
				pins = "PA12";
				phandle = <0x53>;
				bias-pull-up;
			};

			mmc2-pins {
				function = "mmc2";
				pins = "PC0\0PC1\0PC5\0PC6\0PC8\0PC9\0PC10\0PC11\0PC13\0PC14\0PC15\0PC16";
				drive-strength = <0x1e>;
				phandle = <0x15>;
				bias-pull-up;
			};

			uart3-pi-pins {
				function = "uart3";
				pins = "PI9\0PI10";
				phandle = <0x60>;
			};

			uart2-pg-rts-cts-pins {
				function = "uart2";
				pins = "PG17\0PG18";
				phandle = <0x5d>;
			};

			spi1-cs1-pin {
				function = "spi1";
				pins = "PH9";
				phandle = <0x58>;
			};

			ir-rx-pin {
				function = "ir_rx";
				pins = "PH10";
				phandle = <0x30>;
			};

			mmc1-pins {
				function = "mmc1";
				pins = "PG0\0PG1\0PG2\0PG3\0PG4\0PG5";
				drive-strength = <0x1e>;
				phandle = <0x14>;
				bias-pull-up;
			};

			i2c3-ph-pins {
				function = "i2c3";
				pins = "PH4\0PH5";
				phandle = <0x48>;
			};

			uart1-rts-cts-pins {
				function = "uart1";
				pins = "PG8\0PG9";
				phandle = <0x5a>;
			};

			i2c3-pa-pins {
				function = "i2c3";
				pins = "PA10\0PA11";
				phandle = <0x46>;
				bias-pull-up;
			};

			rgmii-pins {
				function = "emac0";
				pins = "PI0\0PI1\0PI2\0PI3\0PI4\0PI5\0PI7\0PI8\0PI9\0PI10\0PI11\0PI12\0PI13\0PI14\0PI15";
				drive-strength = <0x28>;
				phandle = <0x42>;
			};

			mmc0-pins {
				function = "mmc0";
				pins = "PF0\0PF1\0PF2\0PF3\0PF4\0PF5";
				drive-strength = <0x1e>;
				phandle = <0x12>;
				bias-pull-up;
			};

			spi0-cs0-pin {
				function = "spi0";
				pins = "PC3";
				phandle = <0x55>;
			};

			i2c3-pg-pins {
				function = "i2c3";
				pins = "PG17\0PG18";
				phandle = <0x47>;
			};

			x32clk-fanout-pin {
				function = "clock";
				pins = "PG10";
				phandle = <0x64>;
			};

			spi1-pins {
				function = "spi1";
				pins = "PH6\0PH7\0PH8";
				phandle = <0x56>;
			};

			i2s3-pins {
				function = "i2s3";
				pins = "PH5\0PH6\0PH7\0PH8\0PH9";
				phandle = <0x4c>;
			};

			uart2-ph-rts-cts-pins {
				function = "uart2";
				pins = "PH7\0PH8";
				phandle = <0x5f>;
			};

			pwm1-pg-pin {
				function = "pwm1";
				pins = "PG19";
				phandle = <0x4d>;
			};

			i2c2-pi-pins {
				function = "i2c2";
				pins = "PI9\0PI10";
				phandle = <0x45>;
			};

			uart4-pi-rts-cts-pins {
				function = "uart4";
				pins = "PI15\0PI16";
				phandle = <0x62>;
			};

			i2c0-pins {
				function = "i2c0";
				pins = "PI5\0PI6";
				phandle = <0x19>;
			};

			uart2-pi-pins {
				function = "uart2";
				pins = "PI5\0PI6";
				phandle = <0x5b>;
			};

			uart0-ph-pins {
				function = "uart0";
				pins = "PH0\0PH1";
				phandle = <0x18>;
			};

			uart1-pins {
				function = "uart1";
				pins = "PG6\0PG7";
				phandle = <0x59>;
			};

			spi0-pins {
				function = "spi0";
				pins = "PC0\0PC2\0PC4";
				phandle = <0x54>;
			};

			i2s2-pins {
				function = "i2s2";
				pins = "PG10\0PG11\0PG12\0PG13\0PG14";
				phandle = <0x4b>;
			};

			i2c2-ph-pins {
				function = "i2c2";
				pins = "PH2\0PH3";
				phandle = <0x44>;
			};

			uart4-pi-pins {
				function = "uart4";
				pins = "PI13\0PI14";
				phandle = <0x61>;
			};

			uart2-ph-pins {
				function = "uart2";
				pins = "PH5\0PH6";
				phandle = <0x5e>;
			};

			pwm1-ph-pin {
				function = "pwm1";
				pins = "PH3";
				phandle = <0x4e>;
			};

			spdif-tx-pin {
				function = "spdif";
				pins = "PH4";
				phandle = <0x1e>;
			};
		};

		ahub-i2s1@5097000 {
			daudio_master = <0x04>;
			clock-names = "apb\0audio-codec-1x\0audio-codec-4x\0audio-hub";
			signal_inversion = <0x01>;
			mclk_div = <0x01>;
			clocks = <0x02 0x5f 0x02 0x5b 0x02 0x5c 0x02 0x5e>;
			pinconfig = <0x00>;
			#sound-dai-cells = <0x00>;
			frametype = <0x00>;
			compatible = "allwinner,sunxi-ahub-daudio";
			audio_format = <0x01>;
			slot_width_select = <0x20>;
			status = "disabled";
			tdm_num = <0x01>;
			reg = <0x5097000 0xadf>;
			phandle = <0x81>;
			tdm_config = <0x01>;
			pcm_lrck_period = <0x20>;
		};

		power-controller@7010250 {
			#power-domain-cells = <0x01>;
			compatible = "allwinner,sun50i-h616-prcm-ppu";
			reg = <0x7010250 0x10>;
			phandle = <0x0e>;
		};

		ahub_dam_plat@5097000 {
			clock-names = "clk_pll_audio\0clk_pll_audio_4x\0clk_audio_hub\0clk_bus_audio_hub";
			resets = <0x02 0x25>;
			clocks = <0x02 0x5b 0x02 0x5c 0x02 0x5e 0x02 0x5f>;
			#sound-dai-cells = <0x00>;
			compatible = "allwinner,sunxi-snd-plat-ahub_dam";
			status = "disabled";
			reg = <0x5097000 0x1000>;
			phandle = <0x20>;
		};

		bus@1000000 {
			#address-cells = <0x01>;
			allwinner,sram = <0x0b 0x01>;
			#size-cells = <0x01>;
			compatible = "allwinner,sun50i-h616-de33\0allwinner,sun50i-a64-de2";
			ranges = <0x00 0x1000000 0x400000>;
			reg = <0x1000000 0x400000>;

			mixer@100000 {
				clock-names = "bus\0mod";
				resets = <0x0c 0x00>;
				clocks = <0x0c 0x00 0x0c 0x06>;
				compatible = "allwinner,sun50i-h616-de33-mixer-0";
				reg = <0x100000 0x100000 0x8100 0x40 0x280000 0x20000>;
				phandle = <0x06>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@1 {
						reg = <0x01>;
						phandle = <0x38>;

						endpoint {
							remote-endpoint = <0x0d>;
							phandle = <0x28>;
						};
					};
				};
			};

			clock@8000 {
				#reset-cells = <0x01>;
				clock-names = "mod\0bus";
				resets = <0x02 0x01>;
				clocks = <0x02 0x1d 0x02 0x1e>;
				#clock-cells = <0x01>;
				compatible = "allwinner,sun50i-h616-de33-clk";
				reg = <0x8000 0x100>;
				phandle = <0x0c>;
			};
		};

		i2c@5002800 {
			#address-cells = <0x01>;
			resets = <0x02 0x19>;
			interrupts = <0x00 0x08 0x04>;
			clocks = <0x02 0x4a>;
			#size-cells = <0x00>;
			dma-names = "rx\0tx";
			compatible = "allwinner,sun50i-h616-i2c\0allwinner,sun8i-v536-i2c\0allwinner,sun6i-a31-i2c";
			status = "disabled";
			reg = <0x5002800 0x400>;
			phandle = <0x71>;
