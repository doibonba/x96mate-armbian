	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		secmon@40000000 {
			reg = <0x00 0x40000000 0x00 0x80000>;
			no-map;
		};
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x40000000 0x01 0x00>;
	};
};
